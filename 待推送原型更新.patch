  <main class="map-column"><div ref="mapStage" :class="['map-stage',{dragging}]" @wheel="wheel" @pointerdown="pointerDown" @pointermove="pointerMove" @pointerup="pointerUp" @pointercancel="pointerUp" aria-label="园区设备分布图"><div class="map-world" :style="imageStyle"><img src="assets/monitor/park.jpg" class="park-image" alt="深圳中外运物流园区鸟瞰底图" draggable="false" @error="imageFailed=true"><button v-for="b in buildingMarkers" :key="b.id" :class="['building-pin',{active:selectedBuilding===b.id,'has-alarm':pendingAlarms(b)>0,'alarm-ripple':pendingAlarms(b)>0&&['warehouse-1','office','warehouse-3'].includes(b.id)}]" :style="{left:(b.x*100)+'%',top:(b.y*100)+'%'}" @click.stop="pickBuilding(b)" :aria-label="b.name+(pendingAlarms(b)?'，待处理报警：'+pendingAlarms(b)+'起':'')+'，查看建筑概况'" :aria-pressed="selectedBuilding===b.id"><span>{{b.name}}<small v-if="pendingAlarms(b)">待处理报警：{{pendingAlarms(b)}}起</small></span><i class="fa fa-building-o"><span class="alarm-wave wave-one" aria-hidden="true"></span><span class="alarm-wave wave-two" aria-hidden="true"></span><span class="alarm-wave wave-three" aria-hidden="true"></span></i></button></div><div class="map-bottom"><div class="controls"><button @click="zoom(1.3)" aria-label="放大">＋</button><button @click="zoom(1/1.3)" aria-label="缩小">－</button><button @click="view.zoom=1;view.x=0;view.y=0">复位</button></div></div><div v-if="imageFailed" class="load-error"><span>园区底图加载失败</span><button @click="imageFailed=false;location.reload()">重新加载</button></div></div>
