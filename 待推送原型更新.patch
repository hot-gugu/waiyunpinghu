)}}</span></div><dl class="fields"><template v-for="[label,value] in info" :key="label"><dt>{{label}}：</dt><dd :class="{'detail-overdue':label.includes('超期')&&value&&value!=='否'&&value!=='—'}">{{value||'—'}}</dd></template></dl></section><template v-if="isCaseDetail"><section class="map-detail-section"><h3 class="info-title">复核结果</h3><div v-if="detailRecord.status!=='已复核'" class="map-detail-note pending">待复核</div><div v-else class="map-detail-note"><p v-if="!isCaseDetail" class="review-finished">✓ 已复核</p><dl class="fields"><template v-for="[label,value] in reviewFields" :key="label"><dt>{{label}}：</dt><dd :class="{'detail-overdue':label.includes('超期')&&value&&value!=='否'&&value!=='—'}">{{value||'—'}}</dd></template></dl></div></section></template><section class="map-detail-section"><h3 class="info-title">{{isCaseDetail?'报警照片':'报警截图'}}</h3><img :src="detailRecord.photo||'sample-no-helmet.jpg'" class="scene" alt="报警照片，点击放大" @click="preview=detailRecord.photo||'sample-no-helmet.jpg'"></section><section class="map-detail-section"><h3 class="info-title">报警视频</h3><video v-if="detailRecord.video" :key="detailRecord.id" :src="detailRecord.video" :poster="detailRecord.photo" controls preload="none" class="map-detail-video" @error="videoUnavailable=true"></video><button v-else class="map-detail-video-cover" aria-label="播放报警视频" @click="videoUnavailable=true"><img :src="detailRecord.photo||'sample-no-helmet.jpg'" alt="报警视频封面"><span>▶</span></button><p v-if="videoUnavailable" class="aux" role="status">暂无可播放的报警视频</p></section><template v-if="!isCaseDetail"><section class="map-detail-section"><h3 class="info-title">复核结果</h3><div v-if="detailRecord.status!=='已复核'" class="map-detail-note pending">待复核</div><div v-else class="map-detail-note"><p v-if="!isCaseDetail" class="review-finished">✓ 已复核</p><dl class="fields"><template v-for="[label,value] in reviewFields" :key="label"><dt>{{label}}：</dt><dd :class="{'detail-overdue':label.includes('超期')&&value&&value!=='否'&&value!=='—'}">{{va