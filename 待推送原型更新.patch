':label,value])" :key="label"><dt>{{label}}</dt><dd :class="{'detail-overdue':label.includes('超期')&&value&&value!=='否'&&value!=='—'}">{{value||'—'}}</dd></template></dl></section><template v-if="isCaseDetail"><section class="map-detail-section"><h3 class="info-title">复核结果</h3><div v-if="detailRecord.status!=='已复核'" class="map-detail-note pending">待复核</div><div v-else class="map-detail-note"><p v-if="!isCaseDetail" class="review-finished">✓ 已复核</p><dl class="fields"><template v-for="[label,value] in reviewFields" :key="label"><dt>{{label}}</dt><dd :class="{'detail-overdue':label.includes('超期')&&value&&value!=='否'&&value!=='—'}">{{value||'—'}}</dd></template></dl></div></section></template><section class="map-detail-section"><h3 class="info-title">{{isCaseDetail?'报警照片':'报警截图'}}</h3><img :src="detailRecord.photo||'sample-no-helmet.jpg'" class="scene" alt="报警照片，点击放大" @click="preview=detailRecord.photo||'sample-no-helmet.jpg'"></section><section class="map-detail-section"><h3 class="info-title">报警视频</h3><video v-if="detailRecord.video" :key="detailRecord.id" :src="detailRecord.video" :poster="detailRecord.photo" controls preload="none" class="map-detail-video" @error="videoUnavailable=true"></video><button v-else class="map-detail-video-cover" aria-label="播放报警视频" @click="videoUnavailable=true"><img :src="detailRecord.photo||'sample-no-helmet.jpg'" alt="报警视频封面"><span>▶</span></button><p v-if="videoUnavailable" class="aux" role="status">暂无可播放的报警视频</p></section><template v-if="!isCaseDetail"><section class="map-detail-section"><h3 class="info-title">复核结果</h3><div v-if="detailRecord.status!=='已复核'" class="map-detail-note pending">待复核</div><div v-else class="map-detail-note"><p v-if="!isCaseDetail" class="review-finished">✓ 已复核</p><dl class="fields"><template v-for="[label,value] in reviewFields" :key="label"><dt>{{label}}</dt><dd :class="{'detail-overdue':label.includes('超期')&&value&&value!=='否'&&value!=='—'}">{{value||'—'}}</dd></template></dl></div></section></template><section v-if="isCaseDetail" class="map-detail-section"><h3 class="info-title">处置结果</h3><div v-if="detailRecord.disposal" class="map-detail-note"><dl class="fields"><template v-for="[label,value] in disposal" :key="label"><dt>{{label}}</dt><dd :class="{'detail-overdue':label.includes('超期')&&value&&value!=='否'&&value!=='—'}">{{value||'—'}}</dd></template></dl><div class="map-detail-evidence"><img v-for="file in detailRecord.disposal.evidence||[]" :key="file.id||file.url" :src="file.url" :alt="file.name||'处理照片'" @click="preview=file.url"></div></div><div v-else class="map-detail-note"><dl class="fields"><dt>处置状态</dt><dd>待处置</dd><dt>处置单位</dt><dd>华南单位</dd><dt>处置结果</dt><dd>等待华南单位回传</dd></dl></div></section></div></template></div></section></div>
- <div v-if="actionOpen" class="drawer-mask map-action-mask" @keydown.esc="closeAction"><n-config-provider :theme="naive.darkTheme" :theme-overrides="theme" class="map-action-provider"><section :class="['detail','map-alarm-detail','map-action-detail',{'review-wide':actionMode==='review'}]" role="dialog" aria-modal="true" :aria-label="actionMode==='review'?'报警复核':actionMode==='accept'?'接收处置':'报警处置'"><div class="section-head"><h2>{{actionMode==='review'?'报警复核':actionMode==='accept'?'接收处置':'报警处置'}}</h2><button @click="closeAction" aria-label="关闭操作">×</button></div><div class="detail-content"><template v-if="actionMode==='review'"><div class="review-info-bar"><span>报警ID：<b>{{actionTarget.id}}</b></span><span>违规事件类型：<b>{{actionTarget.type}}</b></span><span>报警时间：<b>{{actionTarget.time}}</b></span><span>设备名称：<b>{{actionTarget.device}}</b></span><span>置信度：<b>{{actionTarget.confidence||'—'}}</b></span><span>报警等级：<b :class="'review-level level-'+(actionTarget.level||'').replace('级','')">{{actionTarget.level||'—'}}</b></span><span>责任区域：<b>{{actionTarget.area||'—'}}</b></span><span>责任人：<b>{{actionTarget.owner||'—'}}</b></span><span>复核超期：<b :class="{'review-overdue':actionTarget.overdue&&actionTarget.overdue!=='否'}">{{actionTarget.overdue||'否'}}</b></span></div><div class="review-body"><div class="review-video-panel"><div class="review-video-stage"><img :src="actionTarget.photo||'sample-normal-scene.jpg'" alt="报警视频画面"><button type="button" class="review-play-btn" @click="toggleVideo" aria-label="播放/暂停"><i :class="videoPlaying?'fa fa-pause':'fa fa-play'"></i></button><div class="review-video-bar"><span>{{videoTimeText}}</span><input type="range" min="0" max="15" step="1" v-model.number="videoProgress" @input="onVideoSeek" aria-label="播放进度"><span>00:15</span></div></div></div><div class="review-form-panel"><div class="review-photo-block"><h3>违规照片</h3><div class="review-photo-wrap"><img :src="actionTarget.photo||'sample-no-helmet.jpg'" alt="违规照片"><svg viewBox="0 0 511 400" preserveAspectRatio="xMidYMid slice"><rect x="62" y="112" width="154" height="222" fill="none" stroke="#ef2f4f" stroke-width="3"/><rect x="62" y="86" :width="Math.min(449,Math.max(110,(actionTarget.type||'').length*16+12))" height="26" rx="2" fill="#ef2f4f"/><text x="68" y="104" fill="white" font-size="15">{{actionTarget.type}}</text></svg></div></div><div class="review-field"><label>事件判定</label><n-select v-model:value="actionForm.eventJudgment" :options="['违规或异常','穿戴不规范','巡检和维保','测试告警','画面异常','算法误报'].map(value=>({label:value,value}))" clearable placeholder="请选择事件判定" to="body" consistent-menu-width /></div><div class="review-result-block"><label>复核结果 <span class="req">*</span></label><div class="review-result-choices"><button type="button" v-for="opt in ['误报','确认违规','计划内事件','疑似']" :key="opt" :data-result="opt" :class="['review-result-btn',{active:actionForm.result===opt}]" @click="actionForm.result=opt">{{opt}}</button></div></div><div v-if="actionForm.result==='误报'" class="review-field"><label>误报类型 <span class="req">*</span></label><n-select v-model:value="actionForm.misreportId" :options="misreportOptions" filterable clearable placeholder="请选择误报类型" to="body" consistent-menu-width /></div><template v-if="actionForm.result==='确认违规'"><div class="review-field"><label>违规事件类型 <span class="req">*</span></label><n-select v-model:value="actionForm.type" :options="types" filterable to="body" consistent-menu-width /></div><div class="review-field"><label>报警等级 <span class="req">*</span></label><n-select v-model:value="actionForm.level" :options="levels" to="body" consistent-menu-width /></div></template><div class="review-field"><label>备注说明 <span class="aux">（选填）</span></label><n-input v-model:value="actionForm.remark" type="textarea" maxlength="200" show-count :autosize="{minRows:3,maxRows:6}" placeholder="请输入备注说明..." /></div></div></div></template> <div v-if="actionMode==='process'" class="map-action-form">
